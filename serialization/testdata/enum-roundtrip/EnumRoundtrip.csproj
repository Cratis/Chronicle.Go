<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
    <NuGetAudit>false</NuGetAudit>
    <NuGetLockFilePath>../enum/capture/packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cratis.Chronicle" Version="[19.29.4]" />
    <PackageReference Include="Cratis.Fundamentals" Version="[7.19.6]" />
    <Compile Include="../enum/capture/Declarations.cs" Link="Declarations.cs" />
    <Compile Include="../enum/capture/Isolation.cs" Link="Isolation.cs" />
  </ItemGroup>
</Project>
