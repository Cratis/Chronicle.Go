<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
    <NuGetAudit>false</NuGetAudit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cratis.Chronicle" Version="[19.29.4]" />
    <PackageReference Include="Cratis.Fundamentals" Version="[7.19.6]" />
    <!-- The package ships these runtime assemblies without matching ref assemblies. -->
    <Reference Include="Cratis.Chronicle.Contracts">
      <HintPath>$(NuGetPackageRoot)cratis.chronicle/19.29.4/lib/net10.0/Cratis.Chronicle.Contracts.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
