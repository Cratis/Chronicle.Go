{
  "EventSequenceId": "event-log",
  "Identifier": "Example.AuditProjection",
  "ReadModel": "Example.Audit",
  "IsActive": true,
  "IsRewindable": true,
  "InitialModelState": "{}",
  "From": [
    {"Key": {"Id": "audit-cleared", "Generation": 1}, "Value": {"Key": "$eventSourceId", "Properties": {"labels": "$null", "attributes": "$null"}}},
    {"Key": {"Id": "audit-stamped", "Generation": 1}, "Value": {"Key": "$eventSourceId", "Properties": {"labels": "$eventContext(Tags)", "attributes": "attributes", "corrId": "$eventContext(correlationId)"}}}
  ],
  "All": {},
  "AutoMap": "Enabled",
  "NoAutoMapProperties": ["attributes", "labels"]
}
